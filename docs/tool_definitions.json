  {
    "name": "escalate",
    "description": "Record an evidence-linked human handoff. This does not certify that escalation is justified.",
    "input_schema": {
      "type": "object",
      "properties": {
        "referral_id": {
          "type": "string",
          "minLength": 1
        },
        "blocker_code": {
          "type": "string",
          "enum": [
            "missing_required_document",
            "unsubmitted_complete_packet",
            "scheduling_pending",
            "missing_authorization",
            "required_document_unavailable",
            "authorization_denied_human_appeal",
            "provider_not_accepting",
            "coverage_conflict",
            "document_selection_required",
            "appointment_record_mismatch",
            "report_delivery_pending",
            "report_delivery_failed",
            "no_feasible_slot",
            "authorization_expired",
            "report_unavailable_or_invalid",
            "no_eligible_provider"
          ]
        },
        "evidence_event_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "attempted_action_event_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason_unable_to_proceed": {
          "type": "string",
          "minLength": 1
        },
        "human_action_code": {
          "type": "string",
          "enum": [
            "obtain_required_document",
            "initiate_human_appeal",
            "coordinate_exception",
            "resolve_provider_access",
            "obtain_valid_report"
          ]
        },
        "required_human_action": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "referral_id",
        "blocker_code",
        "evidence_event_ids",
        "attempted_action_event_ids",
        "reason_unable_to_proceed",
        "human_action_code",
        "required_human_action"
      ],
      "additionalProperties": false
    }
  }
]
